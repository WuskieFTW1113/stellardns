<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows shell: a thin WebView2 host around the shared GUI served by the Node core.
       It starts the core, waits for the loopback port, then points the WebView at it.
       The core is copied to <output>/core so a published build is self-describing. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>StellarDNS.Client</AssemblyName>
    <RootNamespace>StellarDNS.Client</RootNamespace>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Window/taskbar/exe icon. Generated by installer\wix\art\make-icon.ps1. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- The tray icon lives in the Notification Area, which is WinForms' NotifyIcon. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded as a WPF resource so Window.Icon and the tray menu can load it by pack URI. -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
  </ItemGroup>

  <!-- The resolver, its GUI page and its runtime dependency tree.
       dns-packet is not self-contained: it requires @leichtgewicht/ip-codec, which npm keeps in
       a sibling folder. Copying only dns-packet shipped an install that died on first launch,
       and naming that folder in an Include silently matched nothing, so the whole node_modules
       tree is globbed and its structure preserved by RecursiveDir. -->
  <ItemGroup>
    <CoreJs Include="..\..\src\**\*.js" />
    <CorePage Include="..\..\public\**\*" />
    <CoreDep Include="..\..\..\node_modules\**\*" />
  </ItemGroup>

  <Target Name="CopyCore" AfterTargets="Build">
    <Copy SourceFiles="@(CoreJs)" DestinationFiles="@(CoreJs->'$(OutDir)core\src\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CorePage)" DestinationFiles="@(CorePage->'$(OutDir)core\public\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CoreDep)" DestinationFiles="@(CoreDep->'$(OutDir)core\node_modules\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="..\..\package.json" DestinationFolder="$(OutDir)core" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyCoreToPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(CoreJs)" DestinationFiles="@(CoreJs->'$(PublishDir)core\src\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CorePage)" DestinationFiles="@(CorePage->'$(PublishDir)core\public\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CoreDep)" DestinationFiles="@(CoreDep->'$(PublishDir)core\node_modules\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="..\..\package.json" DestinationFolder="$(PublishDir)core" SkipUnchangedFiles="true" />
  </Target>

</Project>
