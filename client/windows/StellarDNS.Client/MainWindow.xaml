<Window x:Class="StellarDNS.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="StellarDNS" Height="720" Width="880"
        Icon="Assets/app.ico"
        Background="#070a10" WindowStartupLocation="CenterScreen">
  <Grid Background="#070a10">
    <wv2:WebView2 x:Name="Browser" DefaultBackgroundColor="#070a10" />
    <TextBlock x:Name="Splash" Text="Starting the resolver core…"
               Foreground="#aab6c8" FontFamily="Consolas" FontSize="13"
               HorizontalAlignment="Center" VerticalAlignment="Center" />
  </Grid>
</Window>
