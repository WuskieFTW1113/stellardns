<?xml version="1.0" encoding="utf-8"?>
<!--
  StellarDNS Client — MSI definition (WiX v5).

  Builds a per-machine installer from a published client folder:

    pwsh .\build-msi.ps1 -Runtime win-x64

  It installs the published tree as-is (exe, WebView2 loader, and the Node core in core\),
  creates a Start Menu shortcut, and supports silent install/uninstall:

    msiexec /i StellarDNS-26.0.0-x64.msi /qn
    msiexec /x StellarDNS-26.0.0-x64.msi /qn

  No service is installed and no DNS setting is touched by the installer. Those are explicit
  actions inside the app, because an installer that silently repoints DNS can strand a machine.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="StellarDNS Client"
           Manufacturer="StellarDNS"
           Version="26.0.0"
           UpgradeCode="7E3F1B2A-5C4D-4E8F-9A61-2B8D4C6E1F03"
           Scope="perMachine"
           Compressed="yes"
           InstallerVersion="500">

    <SummaryInformation Description="StellarDNS Client — encrypted DNS with the same policy as your resolver" />

    <!-- Programs and Features otherwise shows a generic MSI glyph. The same icon is embedded
         in the exe, so the shortcut inherits it. -->
    <Icon Id="AppIcon" SourceFile="..\..\StellarDNS.Client\Assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <!-- AllowSameVersionUpgrades: a rebuilt 26.0.0 must be able to replace an installed 26.0.0.
         Without it, re-running a corrected MSI would only offer Repair and keep the bad files. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of StellarDNS Client is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- A running client keeps StellarDNS.Client.exe and core\node.exe open, so Windows
         Installer cannot replace them and the upgrade quietly leaves the old build in place -
         which then opens, finds no Node, and looks like a failed update. Closing the window
         only hides to the tray, so setup stops the process tree itself. /t takes the core with
         it; Return=ignore because a clean machine has nothing to stop. -->
    <CustomAction Id="StopRunningClient"
                  Directory="SystemFolder"
                  ExeCommand="[SystemFolder]taskkill.exe /f /t /im StellarDNS.Client.exe"
                  Execute="immediate"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="StopRunningClient" Before="InstallValidate" />
    </InstallExecuteSequence>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="StellarDNS" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="StellarDNS" />
    </StandardDirectory>

    <Feature Id="Main" Title="StellarDNS Client" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Every file from the publish folder, including core\ and node_modules\.
         SourceDir is passed on the wix command line by build-msi.ps1. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.SourceDir)\**" />
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="AppMenuFolder" Guid="C4A7E1D2-8B3F-4A6C-9E15-7D2B5F8A1C34">
      <Shortcut Id="AppShortcut"
                Name="StellarDNS Client"
                Description="Encrypted DNS client"
                Target="[INSTALLFOLDER]StellarDNS.Client.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />
      <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" />
      <!-- HKLM, not HKCU: this is a per-machine package, and a per-user keypath in a per-machine
           component breaks repair and leaves the shortcut behind on uninstall. -->
      <RegistryValue Root="HKLM" Key="Software\StellarDNS\Client" Name="installed"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- A real wizard: welcome/licence, confirm, progress, finish. Without this a double-click
         shows only a progress bar with nothing to read or cancel. The bitmaps below replace the
         stock WiX art (generated by art\make-art.ps1); Strings.wxl replaces the stock copy. -->
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="art\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="art\dialog.bmp" />
    <ui:WixUI Id="WixUI_Minimal" />

  </Package>
</Wix>
